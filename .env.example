# =============================================================================
# Claric - Environment Configuration
# =============================================================================
# Copy this file to .env and customize values as needed.
# All values have sensible defaults if not specified.

# -----------------------------------------------------------------------------
# Manifest Generation (used by scripts/generate-manifest.cjs)
# -----------------------------------------------------------------------------
HOST=localhost
PORT=3000
PROTOCOL=https
# Stable add-in GUID (generated and persisted to .manifest-guid if unset)
# ADDIN_GUID=00000000-0000-4000-8000-000000000000

# -----------------------------------------------------------------------------
# Store Identity (Microsoft Marketplace submission)
# -----------------------------------------------------------------------------
# Display name shown in Word and the store (default "Claric — AI Writing &
# Editing Assistant for Word"). Keep "X for Word" as a compatibility suffix;
# never brand the name with Microsoft/Office/Word as the product itself.
# DISPLAY_NAME=Claric — AI Writing & Editing Assistant for Word
# Support page URL required by store validation (default: the add-in's own
# root URL). Point this at a real support page, e.g. GitHub issues.
# SUPPORT_URL=https://github.com/Scilence2022/Claric/issues
# Extra domains for the manifest's AppDomains element (comma-separated,
# optional). The SourceLocation domain is implicitly trusted already.
# APP_DOMAINS=api.example.com,llm.example.org

# -----------------------------------------------------------------------------
# Dev Server Configuration
# -----------------------------------------------------------------------------
# Host to bind the webpack dev server (default: 127.0.0.1; set 0.0.0.0 to
# expose the add-in to other machines on the network)
DEV_SERVER_HOST=127.0.0.1
# Port for the webpack dev server
DEV_SERVER_PORT=3000
# Dev-only E2E/coding-agent endpoints (/log, /api/e2e-loop/*, /api/prompts, …).
# They write files under the project root and use wildcard CORS, so they are
# OFF unless explicitly enabled. See scripts/dev-e2e-middlewares.cjs.
# ENABLE_DEV_ENDPOINTS=true
# TLS verification for LLM proxy upstreams. Set to false ONLY for a local
# backend with a self-signed certificate.
# LLM_PROXY_TLS_VERIFY=true

# -----------------------------------------------------------------------------
# SSL Certificates (optional)
# -----------------------------------------------------------------------------
# Paths relative to project root. If not specified, falls back to:
# server.pem / server-key.pem, or webpack's auto-generated self-signed cert.
# SSL_CERT_FILE=my-cert.pem
# SSL_KEY_FILE=my-cert-key.pem

# -----------------------------------------------------------------------------
# Ollama / LLM Proxy Configuration
# -----------------------------------------------------------------------------
# Local proxy path exposed by dev server (browser requests go here)
OLLAMA_PROXY_PATH=/ollama
# Upstream Ollama server URL (where the proxy forwards requests)
OLLAMA_PROXY_TARGET=http://localhost:11434

# -----------------------------------------------------------------------------
# vLLM Proxy Configuration (mirrors the Ollama block above)
# -----------------------------------------------------------------------------
VLLM_PROXY_PATH=/vllm
VLLM_PROXY_TARGET=http://localhost:8026

# -----------------------------------------------------------------------------
# Cloud Provider Proxies (DeepSeek, GLM, Kimi, MiniMax)
# -----------------------------------------------------------------------------
# Same-origin proxy paths let the add-in reach cloud LLM APIs without CORS.
# API keys are entered in the add-in Settings and forwarded through the proxy.
DEEPSEEK_PROXY_PATH=/deepseek
DEEPSEEK_PROXY_TARGET=https://api.deepseek.com
GLM_PROXY_PATH=/glm
GLM_PROXY_TARGET=https://open.bigmodel.cn
KIMI_PROXY_PATH=/kimi
KIMI_PROXY_TARGET=https://api.moonshot.cn
# MiniMax runs two platforms: international (minimax.io) and China (minimax.cn)
MINIMAX_PROXY_PATH=/minimax
MINIMAX_PROXY_TARGET=https://api.minimax.io
MINIMAX_CN_PROXY_PATH=/minimax-cn
MINIMAX_CN_PROXY_TARGET=https://api.minimaxi.com

# -----------------------------------------------------------------------------
# Add-in UI Defaults
# -----------------------------------------------------------------------------
# Default backend URLs shown in settings (user can override via UI)
DEFAULT_OLLAMA_URL=/ollama
DEFAULT_VLLM_URL=/vllm
# Default model selections (user can override via UI)
DEFAULT_MODEL=gpt-oss:20b
VLLM_MODEL=qwen3.5-35b-a3b
