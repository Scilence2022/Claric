{
  "name": "claric",
  "version": "1.0.2",
  "description": "Claric — your redlining scribe for Microsoft Word. AI-powered tracked changes, summarization, and comment analysis.",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "node scripts/generate-icons.cjs && webpack --mode production",
    "lint": "eslint .",
    "test": "jest",
    "coverage": "jest --coverage --coverageReporters=text --coverageReporters=json-summary",
    "check-coverage": "node scripts/check-coverage.cjs",
    "manifest": "node scripts/generate-manifest.cjs",
    "manifest:local": "node scripts/manifest-mode.cjs local",
    "manifest:store": "node scripts/manifest-mode.cjs store",
    "publish:addin": "node scripts/publish-addin.cjs",
    "sideload": "node scripts/sideload-addin.cjs",
    "sideload:remove": "node scripts/sideload-addin.cjs --remove",
    "typecheck": "tsc",
    "verify": "npm run lint && npm test && npm run coverage && npm run check-coverage && npm run typecheck && npm run build",
    "icons": "node scripts/generate-icons.cjs"
  },
  "type": "module",
  "keywords": [
    "office-add-in",
    "word",
    "ai",
    "ollama",
    "vllm",
    "contract-review",
    "tracked-changes",
    "document-summary",
    "ooxml"
  ],
  "author": "Lifu Song",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.14",
    "dotenv": "^17.2.3",
    "mammoth": "^1.12.2",
    "marked": "^17.0.4",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@types/node": "^26.3.0",
    "@types/office-js": "^1.0.0",
    "babel-jest": "^30.2.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.4",
    "style-loader": "^3.3.3",
    "typescript": "^5.9.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scilence2022/Claric.git"
  },
  "bugs": {
    "url": "https://github.com/Scilence2022/Claric/issues"
  },
  "homepage": "https://github.com/Scilence2022/Claric#readme",
  "engines": {
    "node": ">=22"
  }
}
