<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="TaskPaneApp">
  <Id>${GUID}</Id>
  <Version>${VERSION}</Version>
  <ProviderName>Claric</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="${DISPLAY_NAME}"/>
  <Description DefaultValue="Draft, polish, and revise documents with AI inside Word — every change lands as native tracked edits you review before anything is applied. Great for papers, theses, contracts, and everyday writing. Bring your own OpenAI-compatible model."/>
  <IconUrl DefaultValue="${PROTOCOL}://${HOST}${PORT_SUFFIX}${BASE_PATH}/assets/icon-64.png?v=${ICON_CACHE}"/>
  <HighResolutionIconUrl DefaultValue="${PROTOCOL}://${HOST}${PORT_SUFFIX}${BASE_PATH}/assets/icon-80.png?v=${ICON_CACHE}"/>
  <SupportUrl DefaultValue="${SUPPORT_URL}"/>
  ${APP_DOMAINS_BLOCK}<Hosts>
    <Host Name="Document"/>
  </Hosts>
  <!-- WordApi 1.3: table creation (insertTable, table style/headerRowCount).
       Runtime code degrades gracefully on older hosts; this declaration keeps
       the add-in installable everywhere while documenting the baseline. -->
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="WordApi" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="${PROTOCOL}://${HOST}${PORT_SUFFIX}${BASE_PATH}/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
