# =============================================================================
# Word AI Redliner - Docker runtime configuration
# =============================================================================
# Copy to .env alongside docker-compose.yml and customize.

# Hostname/IP of the machine running the container, as reachable from the
# Word client (avoid localhost if Word runs on a different machine).
# Used to render absolute URLs in the generated manifest.xml.
HOST=192.168.1.100

# Host-side port to publish (the container always listens on 3000).
HOST_PORT=3000

# Protocol for the server and manifest URLs. Word requires HTTPS for
# add-in hosting; keep 'https' except for local experiments.
PROTOCOL=https

# TLS certificate files mounted into the container (see docker-compose.yml).
SSL_CERT_FILE=server.pem
SSL_KEY_FILE=server-key.pem

# Stable add-in identity. Leave unset to auto-generate on first start
# (persisted inside the container at /app/.manifest-guid -- note that a
# fresh container will get a fresh GUID unless you set this explicitly).
# ADDIN_GUID=00000000-0000-4000-8000-000000000000

# -----------------------------------------------------------------------------
# LLM backend note
# -----------------------------------------------------------------------------
# The production server does not proxy LLM traffic (the /ollama and /vllm
# proxy paths exist only on the webpack dev server). After sideloading the
# manifest, set the add-in's Endpoint URL (Settings) to an absolute URL
# reachable from the client machine, e.g. https://llm-host:11434.
