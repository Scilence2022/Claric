# =============================================================================
# Word AI Redliner - Docker runtime configuration
# =============================================================================
# Copy to .env alongside docker-compose.yml and customize.

# Hostname/IP of the machine running the container, as reachable from the
# Word client (avoid localhost if Word runs on a different machine).
# Used to render absolute URLs in the generated manifest.xml.
HOST=192.168.1.100

# Host-side port to publish (the container still listens on PORT=3000
# internally). Also used for the absolute URLs in the generated manifest,
# so keep it equal to the port Word will connect to.
HOST_PORT=3000

# Protocol for the server and manifest URLs. Word requires HTTPS for
# add-in hosting; keep 'https' except for local experiments.
PROTOCOL=https

# TLS certificate files mounted into the container (see docker-compose.yml).
SSL_CERT_FILE=server.pem
SSL_KEY_FILE=server-key.pem

# Stable add-in identity. Leave unset to auto-generate on first start
# (persisted inside the container at /app/.manifest-guid -- note that a
# fresh container will get a fresh GUID unless you set this explicitly).
# ADDIN_GUID=00000000-0000-4000-8000-000000000000

# -----------------------------------------------------------------------------
# LLM proxy configuration
# -----------------------------------------------------------------------------
# The server proxies the /ollama and /vllm paths to the upstreams below, so
# the add-in's default Settings (backend URLs /ollama and /vllm) work with
# zero extra configuration. This avoids mixed-content blocking (https page
# fetching http://localhost) and CORS setup on the backend.
#
# Inside a Docker container, reach the host machine via host.docker.internal.
OLLAMA_PROXY_PATH=/ollama
OLLAMA_PROXY_TARGET=http://host.docker.internal:11434
VLLM_PROXY_PATH=/vllm
VLLM_PROXY_TARGET=http://host.docker.internal:8026

# Cloud providers (proxied same-origin; API keys are entered in the add-in
# Settings and forwarded through the proxy). Set a path to empty to disable.
DEEPSEEK_PROXY_PATH=/deepseek
DEEPSEEK_PROXY_TARGET=https://api.deepseek.com
GLM_PROXY_PATH=/glm
GLM_PROXY_TARGET=https://open.bigmodel.cn
KIMI_PROXY_PATH=/kimi
KIMI_PROXY_TARGET=https://api.moonshot.cn
MINIMAX_PROXY_PATH=/minimax
MINIMAX_PROXY_TARGET=https://api.minimax.io
MINIMAX_CN_PROXY_PATH=/minimax-cn
MINIMAX_CN_PROXY_TARGET=https://api.minimaxi.com
# Optional: override the 5-minute upstream timeout (ms)
# LLM_PROXY_TIMEOUT_MS=300000
#
# Set a path to empty (e.g. VLLM_PROXY_PATH=) to disable a backend.
# For a remote LLM behind TLS, use an https:// target -- the proxy still
# works and the add-in never leaves the same origin.
